-/* A waiting thread, the synchronous request's future waiter, or NULL to drop. */
+static int ios_apc_keep_enabled( void )
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        /* On by default: with no waiting thread to hand it to, the APC stays queued on the busy
+         * thread for its next server wait. 0 drops it, as before. */
+        const char *e = getenv( "MADEIRA_APC_KEEP" );
+        enabled = !(e && e[0] == '0');
+        fprintf( stderr, "[apc-requeue] keep %s (MADEIRA_APC_KEEP=0 drops an async I/O APC no other "
+                 "thread can take)\n", enabled ? "on" : "off" );
+    }
+    return enabled;
+}
