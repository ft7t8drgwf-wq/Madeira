     }
+#ifdef WINE_IOS
+    ios_volume_trace( info_class, status, (info_class == FileFsVolumeInformation && !status) ?
+                      ((FILE_FS_VOLUME_INFORMATION *)buffer)->VolumeSerialNumber : 0 );
+#endif
     if (needs_close) close( fd );
     return io->Status = status;
 }
