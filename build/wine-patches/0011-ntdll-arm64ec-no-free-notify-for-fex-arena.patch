+
+/* Madeira: the FEX arena holds only the emulator's own allocations (code
+ * buffers, call-return stacks, lookup caches), never guest code. FEX frees
+ * some of them while it holds its code invalidation lock; reporting that free
+ * back to FEX starts a nested invalidation on the same thread, which then
+ * waits forever on a lock it already owns (Stardew Valley: main thread stuck
+ * after "[inval-nested] #2 invalidate 0x7c5c791000", the .NET finalizer
+ * spinning behind it). Frees inside the arena are not reported.
+ * MADEIRA_FEX_ARENA_FREE_NOTIFY=1 reports them again. */
+static ULONG_PTR ios_fex_arena_lo, ios_fex_arena_hi;
+
+static BOOL ios_free_in_fex_arena( void *addr, SIZE_T size )
+{
+    static int notify = -1;
+    ULONG_PTR a = (ULONG_PTR)addr;
+
+    if (notify < 0)
+    {
+        UNICODE_STRING name, value;
+        WCHAR buffer[4];
+
+        RtlInitUnicodeString( &name, L"MADEIRA_FEX_ARENA_FREE_NOTIFY" );
+        value.Buffer = buffer;
+        value.Length = 0;
+        value.MaximumLength = sizeof(buffer);
+        notify = !RtlQueryEnvironmentVariable_U( NULL, &name, &value ) &&
+                 value.Length == sizeof(WCHAR) && buffer[0] == '1';
+    }
+    if (notify || !ios_fex_arena_lo || !ios_fex_arena_hi) return FALSE;
+    if (a < ios_fex_arena_lo || a >= ios_fex_arena_hi) return FALSE;
+    return !size || size <= ios_fex_arena_hi - a;
+}
