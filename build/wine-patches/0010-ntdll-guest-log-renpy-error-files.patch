+/* Which files the mirror reads: *.log and Unity's output_log.txt, and the
+ * text files a Ren'Py game (Python) writes its errors to, since none of them
+ * is a *.log: traceback.txt and errors.txt for script errors, log.txt for the
+ * engine log, stderr.txt in older versions. Doki Doki Literature Club's child
+ * process exits right after loading pyexpat.pyd with no message box and no
+ * exception; the reason is only in those files. Never other text files. */
+static int ios_guest_log_wanted( const char *name )
+{
+    static const char *const files[] =
+    {
+        "output_log.txt", "traceback.txt", "errors.txt", "log.txt", "stderr.txt",
+    };
+    const char *ext = strrchr( name, '.' );
+    size_t i;
+
+    if (ext && !strcasecmp( ext, ".log" )) return 1;
+    for (i = 0; i < sizeof(files) / sizeof(files[0]); i++)
+        if (!strcasecmp( name, files[i] )) return 1;
+    return 0;
+}
