+    if (MissLogged.fetch_add(1, std::memory_order_relaxed) < 8) {
+      LogMan::Msg::EFmt("[mono-bp] alias miss at {:#x} size {}: stored without CodeInvalidationMutex", Dest, Size);
     }
+    Store(Dest);
+  }
+#else
+  {
+    auto lk = GuardSignalDeferringSection(CTX->CodeInvalidationMutex, Thread);
+    Store(Dest);
   }
+#endif
 
   CTX->SyscallHandler->InvalidateGuestCodeRange(Thread, Address, Size);
 }
