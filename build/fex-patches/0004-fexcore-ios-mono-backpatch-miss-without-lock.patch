+  {
+    auto lk = GuardSignalDeferringSection(CTX->CodeInvalidationMutex, Thread);
+    const uint64_t RW = IosMonoResolveRW(Dest, Size);
+    ios_fex_mono_count_helper(RW ? 0 : 1);
