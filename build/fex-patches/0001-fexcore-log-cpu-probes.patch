+void CPUIDEmu::ProbeLogResult(uint32_t Function, uint32_t Leaf, const FEXCore::CPUID::FunctionResults& Res) {
+  static std::atomic<uint64_t> Seen[128];
+  const uint64_t Key = ((uint64_t(Function) << 32) | Leaf) + 1;
+  for (auto& Slot : Seen) {
+    uint64_t Current = Slot.load(std::memory_order_relaxed);
+    if (Current == Key) {
+      return;
+    }
+    if (Current == 0) {
+      if (!Slot.compare_exchange_strong(Current, Key)) {
+        if (Current == Key) {
+          return;
+        }
+        continue;
+      }
+      LogMan::Msg::EFmt("[cpu-probe] cpuid fn={:#x} leaf={:#x} -> eax={:08x} ebx={:08x} ecx={:08x} edx={:08x}", Function, Leaf, Res.eax,
+                        Res.ebx, Res.ecx, Res.edx);
+      return;
+    }
+  }
+}
+
 } // namespace FEXCore
