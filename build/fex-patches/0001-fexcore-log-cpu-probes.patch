 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstdint>
 
 namespace FEXCore::IR {
 
+/* MADEIRA cpu-probe: logs where guest code uses instructions that can tell an emulator from a real
+ * CPU (cpuid, rdtsc, sidt and friends, traps and undefined opcodes), when the JIT compiles them.
+ * Each kind logs its first 48 sites, so a probe from Steam's CEG module shows up as a guest address.
+ * Compiling a block can run more than once, so a site may repeat. */
+enum class ProbeKind : uint8_t { CPUID, RDTSC, RDTSCP, SGDT, SIDT, SMSW, INT, UNIMPLEMENTED, RESTRICTED, INVALID, COUNT };
+
+static void ProbeLogSite(ProbeKind Kind, const X86Tables::DecodedInst* Op) {
+  static constexpr const char* Names[] = {"cpuid",  "rdtsc", "rdtscp",        "sgdt",       "sidt",
+                                          "smsw",   "int",   "unimplemented", "restricted", "invalid"};
+  static std::atomic<uint32_t> Counts[size_t(ProbeKind::COUNT)];
+  const auto N = Counts[size_t(Kind)].fetch_add(1, std::memory_order_relaxed);
+  if (N >= 48) {
+    return;
+  }
+  LogMan::Msg::EFmt("[cpu-probe] site {} #{} rip={:#x} op={:#x} size={}", Names[size_t(Kind)], N + 1, Op->PC, Op->OP, Op->InstSize);
+}
+
 using X86Tables::OpToIndex;
 
