+/* Another graphics runtime in this process (the D3D12 layer's
+ * OpenSharedHandle) reads an in-process shared handle here: it gets the Metal
+ * texture behind it, with a reference the caller releases, and its D3D11
+ * description. Same-process sharing is what D3D11 -> D3D12 interop of one
+ * application needs. Only a 2D texture whose Metal texture matches its
+ * description resolves (no dropped mips, not renamable). */
+extern "C" BOOL WINAPI
+MadeiraSharedTextureLookup(HANDLE handle, obj_handle_t *pMetal, D3D11_TEXTURE2D_DESC *pDesc) {
+  using namespace dxmt;
+  if (!IsLocalShare(reinterpret_cast<uintptr_t>(handle)))
+    return FALSE;
+  LocalShare share;
+  {
+    std::lock_guard<std::mutex> lock(local_share_mutex);
+    auto it = local_shares.find((uint32_t)reinterpret_cast<uintptr_t>(handle));
+    if (it == local_shares.end() || !it->second.acquire(it->second.texture))
+      return FALSE;
+    share = it->second;
+  }
+  return share.lookup(share.texture, pMetal, pDesc);
+}
