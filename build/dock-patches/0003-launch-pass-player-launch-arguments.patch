diff --git a/src/launch.c b/src/launch.c
index a816c82..ff8877a 100644
--- a/src/launch.c
+++ b/src/launch.c
@@ -203,6 +203,26 @@ int sh_launch(HMODULE module, void *engine, void *client_user,
         return 45;
     }
     o->event("launch-option-index", (int32_t)launch_option);
+    /* The player's own launch options (Steam's "Set launch options"), which
+     * Valve's client adds after the launch option's arguments. The app sets
+     * MADEIRA_STEAM_HOST_LAUNCH_ARGS from Game details > Launch arguments;
+     * unset or empty passes none, as before. */
+    static char user_args[1024];
+    static wchar_t user_args_wide[1024];
+    user_args[0] = 0;
+    SetLastError(ERROR_SUCCESS);
+    DWORD args_length = GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_LAUNCH_ARGS", user_args_wide, 1024);
+    if (args_length) {
+        if (args_length >= 1024 ||
+            !WideCharToMultiByte(CP_UTF8, 0, user_args_wide, -1, user_args, sizeof(user_args), NULL, NULL)) {
+            o->event("launch-args-invalid", 1);
+            return 45;
+        }
+        o->event("launch-args-length", (int32_t)strlen(user_args));
+    } else if (GetLastError() != ERROR_ENVVAR_NOT_FOUND && GetLastError() != ERROR_SUCCESS) {
+        o->event("launch-args-invalid", 1);
+        return 45;
+    }
     static char actual_utf8[32768];
     static wchar_t actual[32768], expected[32768], normalized[32768];
     DWORD length = GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_EXPECTED_INSTALL", expected, 32768);
@@ -256,7 +276,7 @@ int sh_launch(HMODULE module, void *engine, void *client_user,
     o->event("launch-client-discovery-published", 1);
     SetConsoleCtrlHandler(on_control, TRUE);
     uint64_t gameid = appid;
-    uint64_t call = ((launch_fn)(*(void ***)manager)[2])(manager, &gameid, launch_option, 0, "");
+    uint64_t call = ((launch_fn)(*(void ***)manager)[2])(manager, &gameid, launch_option, 0, user_args);
     o->event("launch-request-submitted", call != 0);
     if (!call) { result = 43; goto done; }
     uint64_t begin = o->now_ms(), stopped_at = 0;
@@ -384,7 +404,7 @@ int sh_launch(HMODULE module, void *engine, void *client_user,
         }
         if (retry_at && !seen_running && o->now_ms() >= retry_at) {
             retry_at = 0;
-            call = ((launch_fn)(*(void ***)manager)[2])(manager, &gameid, launch_option, 0, "");
+            call = ((launch_fn)(*(void ***)manager)[2])(manager, &gameid, launch_option, 0, user_args);
             ++retries;
             if (retries <= 3 || retries % 60 == 0) o->event("launch-update-retry", (int32_t)retries);
             if (!call) { result = 43; goto done; }
