+static bool sh_wide_prefix(const wchar_t *text, const wchar_t *prefix)
+{
+    if (!text || !prefix) return false;
+    for (; *prefix; ++text, ++prefix)
+        if (sh_wide_lower(*text) != sh_wide_lower(*prefix)) return false;
+    return true;
+}
+
+static bool sh_wide_separator(wchar_t c)
+{
+    return c == L'\\' || c == L'/';
+}
+
+enum sh_game_scm_mode sh_game_scm_mode(const wchar_t *value)
+{
+    if (!value) return SH_GAME_SCM_AUTO;
+    if (value[0] == L'0' && !value[1]) return SH_GAME_SCM_OFF;
+    if (value[0] == L'1' && !value[1]) return SH_GAME_SCM_ON;
+    return SH_GAME_SCM_AUTO;
+}
+
+bool sh_path_in_folder(const wchar_t *path, const wchar_t *folder)
+{
+    if (!path || !folder || !*folder) return false;
+    size_t length = wcslen(folder);
+    while (length && sh_wide_separator(folder[length - 1])) --length;
+    if (!length) return false;
+    for (size_t i = 0; i < length; ++i) {
+        wchar_t a = sh_wide_lower(path[i]), b = sh_wide_lower(folder[i]);
+        if (sh_wide_separator(a) && sh_wide_separator(b)) continue;
+        if (a != b) return false;
+    }
+    return sh_wide_separator(path[length]);
+}
+
+bool sh_image_is_windows(const wchar_t *image, const wchar_t *windows_dir)
+{
+    if (!image) return false;
+    /* Registry forms: a quoted path, an NT prefix, or a path relative to the
+     * Windows folder. The arguments after the image do not matter here. */
+    while (*image == L'"' || *image == L' ') ++image;
+    if (sh_wide_prefix(image, L"\\??\\")) image += 4;
+    if (sh_wide_prefix(image, L"%SystemRoot%") || sh_wide_prefix(image, L"\\SystemRoot") ||
+        sh_wide_prefix(image, L"System32\\") || sh_wide_prefix(image, L"SysWOW64\\") ||
+        sh_wide_prefix(image, L"%windir%")) return true;
+    return sh_path_in_folder(image, windows_dir);
+}
+
+bool sh_service_is_foreign_autostart(uint32_t type, uint32_t start, const wchar_t *image,
+                                     const wchar_t *windows_dir)
+{
+    /* SERVICE_WIN32_*; SERVICE_AUTO_START or SERVICE_DEMAND_START: a program
+     * that registered a demand-start service starts it itself through the
+     * manager, so it needs one as much as an automatic one does. */
+    if (!(type & 0x30u) || (start != 2 && start != 3)) return false;
+    if (!image) return false;
+    while (*image == L'"' || *image == L' ') ++image;
+    if (!*image) return false;
+    return !sh_image_is_windows(image, windows_dir);
+}
+
+bool sh_game_scm_wanted(enum sh_game_scm_mode mode, unsigned foreign_autostart)
+{
+    if (mode == SH_GAME_SCM_OFF) return false;
+    if (mode == SH_GAME_SCM_ON) return true;
+    return foreign_autostart > 0;
+}
+
+enum sh_keep_alive_mode sh_keep_alive_mode(const wchar_t *value)
+{
+    if (value && value[0] == L'0' && !value[1]) return SH_KEEP_ALIVE_OFF;
+    return SH_KEEP_ALIVE_AUTO;
+}
+
+bool sh_keep_alive_listed(const wchar_t *list, const wchar_t *name)
+{
+    if (!list || !name || !*name) return false;
+    size_t length = wcslen(name);
+    const wchar_t *entry = list;
+    for (;;) {
+        while (*entry == L' ' || *entry == L';') ++entry;
+        if (!*entry) return false;
+        const wchar_t *end = entry;
+        while (*end && *end != L';') ++end;
+        const wchar_t *stop = end;
+        while (stop > entry && stop[-1] == L' ') --stop;
+        if ((size_t)(stop - entry) == length) {
+            size_t i = 0;
+            while (i < length && sh_wide_lower(entry[i]) == sh_wide_lower(name[i])) ++i;
+            if (i == length) return true;
+        }
+        if (!*end) return false;
+        entry = end + 1;
+    }
+}
+
+bool sh_keep_alive_holds(bool windows_image, bool visible_window, uint64_t age_ms, uint64_t young_ms)
+{
+    if (windows_image) return false;
+    return visible_window || age_ms < young_ms;
+}
diff --git a/src/validation.h b/src/validation.h
index aa98191..db67869 100644
--- a/src/validation.h
+++ b/src/validation.h
@@ -6,6 +6,7 @@
 #include <stdbool.h>
 #include <stdint.h>
 #include <stddef.h>
+#include <wchar.h>
 /* Extra LaunchApp arguments are one bounded UTF-8 string, never a shell command.
  * The Swift library profile enforces the same byte/quote/token/control bounds. */
 #define SH_LAUNCH_ARGUMENTS_CAPACITY 4096u
@@ -85,4 +86,49 @@ enum sh_install_scm sh_install_scm_outcome(bool enabled, uint32_t first_error,
                                            bool spawned, bool reachable);
 /* "started", "already", "off"; "failed" for any other value. */
 const char *sh_install_scm_word(int32_t outcome);
+
+/* ml2020: a game session's own service manager and the hold while a game's
+ * launcher restarts (launch.c, hold.c). Pure decisions; the Windows calls
+ * stay in the host files so the native sanitizer tests cover these.
+ *
+ * MADEIRA_DOCK_GAME_SCM: "0" never starts a service manager for the game
+ * session, "1" always does; unset (or any other value) starts one only when
+ * a program installed an automatic-start Windows service of its own in this
+ * prefix, which only a running service manager can start.
+ */
+enum sh_game_scm_mode { SH_GAME_SCM_OFF = 0, SH_GAME_SCM_ON = 1, SH_GAME_SCM_AUTO = 2 };
+enum sh_game_scm_mode sh_game_scm_mode(const wchar_t *value);
+/* A service entry under System\CurrentControlSet\Services that Windows
+ * a program may start and that is not part of Windows: a Win32 service
+ * (type 0x10 or 0x20) with start type 2 (automatic) or 3 (on demand, which
+ * the program that registered it starts itself) whose image is neither
+ * under the Windows folder nor given relative to it (%SystemRoot%,
+ * \SystemRoot, System32\, SysWOW64\). Wine's own services all fail this
+ * test; a launcher's own service passes it.
+ */
+bool sh_service_is_foreign_autostart(uint32_t type, uint32_t start, const wchar_t *image,
+                                     const wchar_t *windows_dir);
+bool sh_game_scm_wanted(enum sh_game_scm_mode mode, unsigned foreign_autostart);
+
+/* MADEIRA_DOCK_KEEP_ALIVE: "0" ends the session as before, 3 s after Valve's
+ * client stops reporting the game as running. Unset, empty or a `;`-separated
+ * list of image file names: the end is postponed while a process of the
+ * game's own tree (descended from this host, Windows images and their
+ * children excepted) or with a listed image name still shows a window or is
+ * younger than SH_KEEP_ALIVE_YOUNG_MS. A launcher that restarts itself is
+ * young; the game it then starts shows a window; a launcher left behind in
+ * the background after the game ends is neither, so the session ends.
+ */
+#define SH_KEEP_ALIVE_YOUNG_MS 60000ULL
+enum sh_keep_alive_mode { SH_KEEP_ALIVE_OFF = 0, SH_KEEP_ALIVE_AUTO = 1 };
+enum sh_keep_alive_mode sh_keep_alive_mode(const wchar_t *value);
+/* `name` (an image file name) is one of the `;`-separated entries, no case. */
+bool sh_keep_alive_listed(const wchar_t *list, const wchar_t *name);
+/* `path` lies inside `folder` (no case; a separator must follow the folder). */
+bool sh_path_in_folder(const wchar_t *path, const wchar_t *folder);
+/* `image` is Windows' own: inside windows_dir, or given relative to it. */
+bool sh_image_is_windows(const wchar_t *image, const wchar_t *windows_dir);
+/* One tracked process holds the session while it is not a Windows image and
+ * either shows a window or is younger than young_ms. */
+bool sh_keep_alive_holds(bool windows_image, bool visible_window, uint64_t age_ms, uint64_t young_ms);
 #endif
diff --git a/tests/test-validation.c b/tests/test-validation.c
index b788658..1590039 100644
--- a/tests/test-validation.c
+++ b/tests/test-validation.c
@@ -172,6 +172,53 @@ int main(void)
     assert(!strcmp(sh_install_scm_word(SH_INSTALL_SCM_OFF), "off"));
     assert(!strcmp(sh_install_scm_word(SH_INSTALL_SCM_FAILED), "failed"));
     assert(!strcmp(sh_install_scm_word(7), "failed"));
-    puts("steam-host: launch-option, launch-arguments, entitlement-list, launch-result, content-wait, config-wait, session-wait, CEG, service-manager "
-         "and install-service-manager validation cases passed");
+    /* ml2020: the game session's service manager (auto: a foreign automatic service). */
+    assert(sh_game_scm_mode(NULL) == SH_GAME_SCM_AUTO && sh_game_scm_mode(L"") == SH_GAME_SCM_AUTO);
+    assert(sh_game_scm_mode(L"0") == SH_GAME_SCM_OFF && sh_game_scm_mode(L"1") == SH_GAME_SCM_ON);
+    assert(sh_game_scm_mode(L"01") == SH_GAME_SCM_AUTO && sh_game_scm_mode(L"auto") == SH_GAME_SCM_AUTO);
+    const wchar_t *windows = L"C:\\windows";
+    assert(sh_path_in_folder(L"C:\\windows\\system32\\services.exe", windows));
+    assert(sh_path_in_folder(L"c:/WINDOWS/system32/svchost.exe", L"C:\\Windows\\"));
+    assert(!sh_path_in_folder(L"C:\\windows2\\x.exe", windows));
+    assert(!sh_path_in_folder(L"C:\\windows", windows) && !sh_path_in_folder(L"C:\\win", windows));
+    assert(!sh_path_in_folder(NULL, windows) && !sh_path_in_folder(L"C:\\windows\\a", NULL) &&
+           !sh_path_in_folder(L"C:\\windows\\a", L"\\"));
+    assert(sh_image_is_windows(L"%SystemRoot%\\system32\\svchost.exe -k netsvcs", windows));
+    assert(sh_image_is_windows(L"\\SystemRoot\\System32\\drivers\\mountmgr.sys", windows));
+    assert(sh_image_is_windows(L"System32\\DRIVERS\\x.sys", windows));
+    assert(sh_image_is_windows(L"\\??\\C:\\windows\\system32\\drivers\\y.sys", windows));
+    assert(sh_image_is_windows(L"\"C:\\windows\\system32\\msiexec.exe\" /V", windows));
+    assert(!sh_image_is_windows(L"\"C:\\Program Files\\Publisher\\Launcher\\Service.exe\"", windows));
+    assert(!sh_image_is_windows(L"C:\\Games\\game\\service.exe", windows) && !sh_image_is_windows(NULL, windows));
+    /* type 0x10 own process, 0x20 shared; start 2 automatic, 3 demand, 4 disabled */
+    assert(sh_service_is_foreign_autostart(0x10, 2, L"\"C:\\Program Files\\Publisher\\Service.exe\"", windows));
+    assert(sh_service_is_foreign_autostart(0x20, 2, L"C:\\Games\\svc.exe --run", windows));
+    assert(sh_service_is_foreign_autostart(0x10, 3, L"C:\\Games\\svc.exe", windows));   /* demand start: the program starts it */
+    assert(!sh_service_is_foreign_autostart(0x10, 4, L"C:\\Games\\svc.exe", windows));  /* disabled */
+    assert(!sh_service_is_foreign_autostart(0x10, 0, L"C:\\Games\\svc.exe", windows) &&
+           !sh_service_is_foreign_autostart(0x10, 1, L"C:\\Games\\svc.exe", windows));  /* boot and system start: drivers */
+    assert(!sh_service_is_foreign_autostart(0x1, 2, L"C:\\Games\\drv.sys", windows));
+    assert(!sh_service_is_foreign_autostart(0x10, 2, L"%SystemRoot%\\system32\\svchost.exe -k x", windows));
+    assert(!sh_service_is_foreign_autostart(0x10, 2, L"C:\\windows\\system32\\spoolsv.exe", windows));
+    assert(!sh_service_is_foreign_autostart(0x10, 2, L"", windows) && !sh_service_is_foreign_autostart(0x10, 2, L"\"\"", windows));
+    assert(!sh_service_is_foreign_autostart(0x10, 2, NULL, windows));
+    assert(!sh_game_scm_wanted(SH_GAME_SCM_OFF, 5) && sh_game_scm_wanted(SH_GAME_SCM_ON, 0));
+    assert(!sh_game_scm_wanted(SH_GAME_SCM_AUTO, 0) && sh_game_scm_wanted(SH_GAME_SCM_AUTO, 1));
+    /* ml2020: the hold while a launcher restarts. */
+    assert(sh_keep_alive_mode(NULL) == SH_KEEP_ALIVE_AUTO && sh_keep_alive_mode(L"") == SH_KEEP_ALIVE_AUTO);
+    assert(sh_keep_alive_mode(L"0") == SH_KEEP_ALIVE_OFF && sh_keep_alive_mode(L"1") == SH_KEEP_ALIVE_AUTO);
+    assert(sh_keep_alive_mode(L"Launcher.exe;Game.exe") == SH_KEEP_ALIVE_AUTO);
+    assert(sh_keep_alive_listed(L"Launcher.exe;Game.exe", L"launcher.EXE"));
+    assert(sh_keep_alive_listed(L"Launcher.exe; Game.exe ", L"game.exe"));
+    assert(sh_keep_alive_listed(L";;Game.exe", L"Game.exe") && sh_keep_alive_listed(L"Game.exe", L"Game.exe"));
+    assert(!sh_keep_alive_listed(L"Launcher.exe;Game.exe", L"Game.ex") && !sh_keep_alive_listed(L"Launcher.exe", L"Launcher.exe2"));
+    assert(!sh_keep_alive_listed(L"", L"Game.exe") && !sh_keep_alive_listed(NULL, L"Game.exe") &&
+           !sh_keep_alive_listed(L"Game.exe", L"") && !sh_keep_alive_listed(L"Game.exe", NULL));
+    assert(!sh_keep_alive_listed(L"1", L"Game.exe"));
+    assert(sh_keep_alive_holds(false, true, 10 * 60000ULL, SH_KEEP_ALIVE_YOUNG_MS));
+    assert(sh_keep_alive_holds(false, false, 5000, SH_KEEP_ALIVE_YOUNG_MS));
+    assert(!sh_keep_alive_holds(false, false, SH_KEEP_ALIVE_YOUNG_MS, SH_KEEP_ALIVE_YOUNG_MS));
+    assert(!sh_keep_alive_holds(true, true, 0, SH_KEEP_ALIVE_YOUNG_MS));
+    puts("steam-host: launch-option, launch-arguments, entitlement-list, launch-result, content-wait, config-wait, session-wait, CEG, service-manager, "
+         "install-service-manager, game-service-manager and keep-alive validation cases passed");
 }
